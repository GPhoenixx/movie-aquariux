{
    "extends": "@react-native/typescript-config/tsconfig.json",
    "compilerOptions": {
        "baseUrl": ".",
        "paths": {
            "@components/*": ["src/components/*"],
            "@models/*": ["src/models/*"],
            "@screens/*": ["src/screens/*"],
            "@repositories/*": ["src/repositories/*"],
            "@const/*": ["src/const/*"],
            "@utils/*": ["src/utils/*"],
            "@global-state/*": ["src/global-state/*"],
            "@assets/*": ["assets/*"]
            // "@/*": ["./*"]
        }
    }
}
